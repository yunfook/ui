{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "yf-ui",
  "homepage": "https://github.com/yunfook/ui",
  "items": [
    {
      "name": "theme",
      "type": "registry:style",
      "title": "yf-ui theme",
      "description": "Color tokens (light + dark) and extra radius scale. Run this once after `shadcn init` to apply the yf-ui look.",
      "cssVars": {
        "theme": {
          "radius-sm": "calc(var(--radius) * 0.6)",
          "radius-md": "calc(var(--radius) * 0.8)",
          "radius-lg": "var(--radius)",
          "radius-xl": "calc(var(--radius) * 1.4)",
          "radius-2xl": "calc(var(--radius) * 1.8)",
          "radius-3xl": "calc(var(--radius) * 2.2)",
          "radius-4xl": "calc(var(--radius) * 2.6)"
        },
        "light": {
          "background": "oklch(1 0 0)",
          "foreground": "oklch(0.255 0.005 255)",
          "card": "oklch(1 0 0)",
          "card-foreground": "oklch(0.255 0.005 255)",
          "popover": "oklch(1 0 0)",
          "popover-foreground": "oklch(0.255 0.005 255)",
          "primary": "oklch(0.555 0.197 258)",
          "primary-foreground": "oklch(1 0 0)",
          "secondary": "oklch(0.965 0.012 255)",
          "secondary-foreground": "oklch(0.255 0.005 255)",
          "muted": "oklch(0.965 0.012 255)",
          "muted-foreground": "oklch(0.5 0.012 255)",
          "accent": "oklch(0.965 0.012 255)",
          "accent-foreground": "oklch(0.255 0.005 255)",
          "destructive": "oklch(0.577 0.245 27.325)",
          "border": "oklch(0.9 0.008 255)",
          "input": "oklch(0.9 0.008 255)",
          "ring": "oklch(0.555 0.197 258)",
          "chart-1": "oklch(0.87 0 0)",
          "chart-2": "oklch(0.556 0 0)",
          "chart-3": "oklch(0.439 0 0)",
          "chart-4": "oklch(0.371 0 0)",
          "chart-5": "oklch(0.269 0 0)",
          "radius": "0.75rem",
          "sidebar": "oklch(0.985 0.005 255)",
          "sidebar-foreground": "oklch(0.255 0.005 255)",
          "sidebar-primary": "oklch(0.555 0.197 258)",
          "sidebar-primary-foreground": "oklch(1 0 0)",
          "sidebar-accent": "oklch(0.93 0.025 255)",
          "sidebar-accent-foreground": "oklch(0.255 0.005 255)",
          "sidebar-border": "oklch(0.9 0.008 255)",
          "sidebar-ring": "oklch(0.555 0.197 258)"
        },
        "dark": {
          "background": "oklch(0.22 0.008 255)",
          "foreground": "oklch(0.95 0.005 255)",
          "card": "oklch(0.27 0.01 255)",
          "card-foreground": "oklch(0.95 0.005 255)",
          "popover": "oklch(0.27 0.01 255)",
          "popover-foreground": "oklch(0.95 0.005 255)",
          "primary": "oklch(0.72 0.15 258)",
          "primary-foreground": "oklch(0.18 0.02 258)",
          "secondary": "oklch(0.32 0.012 255)",
          "secondary-foreground": "oklch(0.95 0.005 255)",
          "muted": "oklch(0.32 0.012 255)",
          "muted-foreground": "oklch(0.72 0.012 255)",
          "accent": "oklch(0.32 0.012 255)",
          "accent-foreground": "oklch(0.95 0.005 255)",
          "destructive": "oklch(0.704 0.191 22.216)",
          "border": "oklch(1 0 0 / 10%)",
          "input": "oklch(1 0 0 / 12%)",
          "ring": "oklch(0.72 0.15 258)",
          "chart-1": "oklch(0.87 0 0)",
          "chart-2": "oklch(0.556 0 0)",
          "chart-3": "oklch(0.439 0 0)",
          "chart-4": "oklch(0.371 0 0)",
          "chart-5": "oklch(0.269 0 0)",
          "sidebar": "oklch(0.27 0.01 255)",
          "sidebar-foreground": "oklch(0.95 0.005 255)",
          "sidebar-primary": "oklch(0.72 0.15 258)",
          "sidebar-primary-foreground": "oklch(0.18 0.02 258)",
          "sidebar-accent": "oklch(0.32 0.012 255)",
          "sidebar-accent-foreground": "oklch(0.95 0.005 255)",
          "sidebar-border": "oklch(1 0 0 / 10%)",
          "sidebar-ring": "oklch(0.72 0.15 258)"
        }
      }
    },
